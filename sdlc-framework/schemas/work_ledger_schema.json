{
  "schema_version": "1.0",
  "description": "Defines the structure for the persistent Work Ledger, the single source of truth for all project work.",
  "fields": {
    "id": {"type": "string", "description": "Unique, sequential identifier (e.g., WORK-001)."},
    "type": {"type": "enum", "values": ["Task", "Bug", "Issue", "Question", "Decision", "Blocker", "Handoff", "TechnicalDebt", "ReviewFinding", "MigrationItem", "Dependency"], "description": "Classification of the work item."},
    "title": {"type": "string", "description": "Concise summary."},
    "status": {"type": "enum", "values": ["proposed", "pending", "ready", "in_progress", "blocked", "in_review", "done", "deferred", "cancelled", "superseded"], "description": "The current state of the work item."},
    "priority": {"type": "enum", "values": ["low", "medium", "high", "critical"], "description": "Assigned priority."},
    "source": {"type": "object", "properties": {
        "type": {"type": "string"},
        "reference": {"type": "string", "description": "Reference to the spec/area/task that generated the item."}
    }, "required": ["type", "reference"]},
    "context": {"type": "string", "description": "Detailed background/problem description."},
    "dependencies": {"type": "array", "items": {"type": "string"}, "description": "List of Work IDs this item depends on."},
    "next_action": {"type": "string", "description": "The mandatory, concrete next step required to move status forward."}
  }
}